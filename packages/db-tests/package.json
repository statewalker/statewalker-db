{
  "name": "@statewalker/db-tests",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Shared conformance test suite for @statewalker/db-api implementations. Consumed by the db-* node adapters and, via Vitest browser mode, the browser adapters (pass skipFilePersistence to drop the node-only scenario).",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-db/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-db/tree/main/packages/db-tests#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-db.git",
    "directory": "packages/db-tests"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/db-api": "workspace:^"
  },
  "peerDependencies": {
    "vitest": "catalog:peers"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
